# Copy to .env and fill in before running `docker compose up`

# Anthropic API key used for sample-sentence generation
ANTHROPIC_API_KEY=

# Postgres credentials
POSTGRES_DB=language_cards
POSTGRES_USER=language_cards
POSTGRES_PASSWORD=change-me

# GHCR namespace the backend/piper images are published under, e.g. ghcr.io/yourusername
IMAGE_NAMESPACE=ghcr.io/yourusername
