# Copy to .env and fill in before running `docker compose up`

# Which sentence-generation provider to use: claude | croissant
SENTENCE_PROVIDER=claude

# Anthropic API key, only needed when SENTENCE_PROVIDER=claude
ANTHROPIC_API_KEY=

# Ollama model tag, only used when SENTENCE_PROVIDER=croissant. Pull it once with:
#   docker compose exec ollama ollama pull hf.co/croissantllm/CroissantLLMChat-v0.1-GGUF:Q4_K_M
OLLAMA_MODEL=hf.co/croissantllm/CroissantLLMChat-v0.1-GGUF:Q4_K_M

# Which service translates sample sentences to English: croissant | google-unofficial
# croissant reuses the Ollama model above. google-unofficial calls Google Translate's free,
# undocumented web endpoint (no API key, but unsupported and may break or get rate-limited).
SENTENCE_TRANSLATION_PROVIDER=croissant

# Postgres credentials
POSTGRES_DB=language_cards
POSTGRES_USER=language_cards
POSTGRES_PASSWORD=change-me

# GHCR namespace the backend/piper images are published under, e.g. ghcr.io/yourusername
IMAGE_NAMESPACE=ghcr.io/yourusername

# Path prefix to serve the app under when fronted by nginx (e.g. /language-cards).
# Leave empty to serve at the domain root. Baked into the frontend build at image
# build time, so changing this requires a rebuild, not just a restart.
CONTEXT_PATH=
